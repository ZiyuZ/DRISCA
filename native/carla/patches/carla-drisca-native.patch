+bool AWeather::RenderEnvironment(const FWeatherParameters &Projection,
+    float NativeFogDensity, FString &Error)
+{
+    TArray<AActor *> Skies;
+    UGameplayStatics::GetAllActorsOfClass(GetWorld(), ASkyBase::StaticClass(), Skies);
+    if (Skies.IsEmpty())
+    {
+        Error = TEXT("当前地图缺少天空组件，无法应用环境");
+        return false;
+    }
+    for (AActor *Sky : Skies)
+    {
+        if (Sky->FindComponentByClass<UExponentialHeightFogComponent>() == nullptr ||
+            Sky->FindComponentByClass<USkyAtmosphereComponent>() == nullptr)
+        {
+            Error = TEXT("天空缺少高度雾或大气组件，无法应用环境");
+            return false;
+        }
+    }
+    bEnvironmentRenderer = true;
+    SetActorTickEnabled(false);
+    Weather = Projection;
+    EnvironmentFogDensity = NativeFogDensity;
+    ++ApplySerial;
+    CheckWeatherPostProcessEffects();
+    PushWeatherToSky();
+    UpdateStreetLightsForDayNight();
+    UpdateRain();
+    return true;
+}
+
+void AWeather::MaintainEnvironment()
+{
+    if (!bEnvironmentRenderer) return;
+    UpdateRain();
+    ReleaseDirectionalVSMInvalidateIfSunStill(GetWorld());
+    ReleaseLightingUpdateIfSettled(GetWorld());
+}
+
